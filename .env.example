# 브라우저에 공개해도 되는 Supabase URL과 publishable key만 사용합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Production origin used in guardian access links. Leave empty for local request origin.
# APP_BASE_URL=https://academy.example.com

# 서버 전용 환경변수입니다. NEXT_PUBLIC_ 접두사를 사용하지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=

# 로컬 전용 통합 테스트 대상입니다. 운영 Supabase 주소·키를 넣지 않습니다.
INTEGRATION_SUPABASE_URL=http://127.0.0.1:54321
INTEGRATION_SUPABASE_SERVICE_ROLE_KEY=

# 나중에 SMS·메일·Push 서비스를 연결할 때만 추가합니다.
# SMS_PROVIDER_API_KEY=
